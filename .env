# ==============================================================================
# Agentic AI Predictive & Preventive Maintenance System (APMS)
# Production Environment Variables Configuration (.env)
# ==============================================================================

# Application Environment & Server
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# PostgreSQL / TimescaleDB Telemetry Database
# Host port 5438 matches docker-compose (container 5432).
# Live MQTT persist stays on. Gbotz history pull stays off.
DB_HOST=localhost
DB_PORT=5438
DB_NAME=pdm_telemetry
DB_USER=postgres
DB_PASSWORD=postgres
TELEMETRY_PERSIST_ENABLED=true

# Redis Ring Buffer Storage (Durable Alpha Buffer)
# Host port 6382 matches docker-compose (container 6379). 6379 is taken by marketing_redis.
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_DB=0
REDIS_KEY_PREFIX=apms
ALPHA_BUFFER_TTL_SECONDS=604800

##########################################
SSH_PDM_HOST=168.144.37.186
SSH_PDM_USER=pdm
SSH_PDM_PASSWORD=N.:!Q{0yF3lFkga!
# Industrial MQTT Broker Settings (Live Plant Broker)
MQTT_ENABLED=true
MQTT_BROKER_HOST=165.22.244.151
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE=60
MQTT_USERNAME=embedded
MQTT_PASSWORD=embedded
MQTT_TOPIC_TELEMETRY=pdm/integrated_json
MQTT_TOPIC_ALERTS=pdm/alerts

# Gbotz PDM Sensor API — historical telemetry (POST /api/ai/query)
# Leave WRITE_DB=false: do not pull Gbotz history into Postgres.
AI_SERVICE_BASE_URL=http://168.144.37.186:4000
AI_SERVICE_API_KEY=c6f153556ec88eded14dcf9401a0dec2408c994b0e4ff6f9120ade973fdcf957
GBOTZ_BACKFILL_WRITE_DB=false

# ==============================================================================
# INDUSTRIAL THRESHOLDS CONFIGURATION (EASY TO EDIT)
# All physical thresholds below are loaded dynamically by APMS Micro-Agents
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NAMUR NE43 Hardware Diagnostic Standards (Loop Current mA)
# ------------------------------------------------------------------------------
NAMUR_NE43_FAULT_LOW=3.6          # Wire Break / Disconnect (< 3.6 mA)
NAMUR_NE43_UNDER_RANGE=3.8        # Under-range measurement (3.6 to 3.8 mA)
NAMUR_NE43_OVER_RANGE=20.5        # Over-range measurement (20.5 to 21.0 mA)
NAMUR_NE43_FAULT_HIGH=21.0        # Sensor Short-Circuit / Transducer Fault (> 21.0 mA)

# Sensor Plausibility & Signal Quality Checks (Agent Alpha)
TEMP_TRANSDUCER_OPEN_MIN=-20.0    # Thermocouple open-circuit minimum (°C)
TEMP_TRANSDUCER_OPEN_MAX=180.0    # Thermocouple open-circuit maximum (°C)
SENSOR_FLATLINE_MIN_SAMPLES=15    # Number of stationary samples before flatline detection
SENSOR_FLATLINE_MAX_VARIANCE=0.000001 # Variance threshold for ADC transducer lock

# ------------------------------------------------------------------------------
# 2. Vibration Severity Thresholds (ISO 10816-3 mm/s RMS)
# Class II Medium Industrial Machines (15 kW to 75 kW)
# ------------------------------------------------------------------------------
VIB_NORMAL_MAX=2.8                # ISO 10816-3 Zone A/B Safe Limit (Good/Satisfactory)
VIB_WARNING_MAX=4.5               # ISO 10816-3 Zone C Warning Threshold (Unsatisfactory)
VIB_DANGER_MIN=7.1                # ISO 10816-3 Zone D Danger / Trip Threshold (Unacceptable)
VIBRATION_WARNING_MM_S=4.5        # Alias for ISO 10816 Warning limit
VIBRATION_CRITICAL_MM_S=7.1       # Alias for ISO 10816 Critical limit
VIBRATION_POST_REPAIR_MAX=1.2     # Post-Maintenance Re-commissioning Verification Limit

# ------------------------------------------------------------------------------
# 3. Thermal Operational Thresholds (°C) (IEC 60034-1)
# ------------------------------------------------------------------------------
TEMP_MOTOR_NORMAL_MAX=75.0        # Motor Stator Normal Running Temperature (°C)
TEMP_MOTOR_WARNING_MAX=85.0       # Motor Stator Class F Warning Limit (°C)
TEMP_MOTOR_DANGER_MIN=95.0        # Motor Stator Critical Overheating Trip Limit (°C)

TEMP_COMPRESSOR_NORMAL_MAX=70.0   # Compressor Air-End Normal Temperature (°C)
TEMP_COMPRESSOR_WARNING_MAX=80.0  # Compressor Air-End Warning Temperature (°C)
TEMP_COMPRESSOR_DANGER_MIN=90.0   # Compressor Air-End Critical Trip Temperature (°C)

# Dynamic Weather Compensation & Thermal De-Weathering (Agent Beta)
SITE_AMBIENT_REFERENCE_C=25.0     # Baseline Factory Reference Ambient Temperature (°C)
GENUINE_OVERHEAT_DELTA_C=35.0     # True Motor Rise (Delta T above ambient) Triggering Fault (°C)
AMBIENT_DRIFT_THRESHOLD_C=5.0     # Ambient Drift Deviation to Trigger De-Weathering (°C)

# ------------------------------------------------------------------------------
# 4. Acoustic Noise Level Thresholds (dB - OSHA 1910.95 / ISO 1996)
# ------------------------------------------------------------------------------
SOUND_NORMAL_MAX=82.0             # Normal Operating Acoustic Level (dB)
SOUND_WARNING_MAX=85.0            # OSHA Action Level Warning (dB)
SOUND_DANGER_MIN=90.0             # OSHA Permissible Exposure Limit / Ear Protection Required (dB)

# ------------------------------------------------------------------------------
# 5. Machine 3D Orientation & Foundation Tilt (Degrees - API 670 Standard)
# ------------------------------------------------------------------------------
TILT_ROLL_NORMAL_MAX=2.0          # Foundation Base Roll Normal Limit (deg)
TILT_ROLL_DANGER_MIN=5.0          # Foundation Base Roll Danger Limit (deg)
TILT_PITCH_NORMAL_MAX=2.0         # Foundation Base Pitch Normal Limit (deg)
TILT_PITCH_DANGER_MIN=5.0         # Foundation Base Pitch Danger Limit (deg)
TILT_YAW_NORMAL_MAX=2.0           # Foundation Base Yaw Normal Limit (deg)
TILT_YAW_DANGER_MIN=5.0           # Foundation Base Yaw Danger Limit (deg)

# ------------------------------------------------------------------------------
# 6. 3-Phase Electrical Power Quality (IEC 60038 / IEEE 519 / IEC 61000-4-30)
# ------------------------------------------------------------------------------
# Grid Voltage Limits (400V / 415V Nominal)
VOLTAGE_NORMAL_MIN=380.0          # Safe Grid Minimum Voltage (V RMS)
VOLTAGE_NORMAL_MAX=435.0          # Safe Grid Maximum Voltage (V RMS)
VOLTAGE_DANGER_UNDER=360.0        # Severe Undervoltage Trip Limit (V RMS)
VOLTAGE_DANGER_OVER=455.0         # Severe Overvoltage Trip Limit (V RMS)

# Motor Current Limits (37 kW Motor Baseline)
CURRENT_NORMAL_MIN=5.0            # Minimum Idling Current (A RMS)
CURRENT_NORMAL_MAX=60.0           # Normal Rated Running Current (A RMS)
CURRENT_WARNING_MAX=68.0          # Full Load Amps (FLA) Warning Threshold (A RMS)
CURRENT_DANGER_OVER=75.0          # Stalled Rotor / Locked Shaft Overcurrent Limit (A RMS)

# Active Power Limits (kW)
POWER_NORMAL_MAX=37.0             # Machine Nameplate Rated Power (kW)
POWER_WARNING_MAX=42.0            # Sustained Overpower Warning Threshold (kW)
POWER_DANGER_MIN=45.0             # Motor Overload Trip Threshold (kW)

# Power Factor (cos φ)
PF_NORMAL_MIN=0.85                # Target Industrial Power Factor
PF_WARNING_MIN=0.70               # Poor Power Factor Warning
PF_DANGER_UNDER=0.65              # Severely Degraded Reactive Power Penalty (< 0.65)

# Operating Machine Load %
LOAD_NORMAL_MIN=40.0              # Nominal Minimum Load (%)
LOAD_NORMAL_MAX=85.0              # Efficient Operational Load Range (%)
LOAD_DANGER_OVER=105.0            # Sustained Overload Trip (%)

# IEC 61000-4-30 Voltage Unbalance Factor (VUF %)
VUF_NORMAL_MAX=1.5                # IEC 61000-4-30 Safe Grid Unbalance (%)
VUF_WARNING_MAX=2.5               # Elevated Stator Stress Warning (%)
VUF_DANGER_MIN=3.0                # Severe Phase Imbalance / Single-Phasing Risk (%)

# IEEE 519 Total Harmonic Distortion (%THD)
THD_NORMAL_MAX=5.0                # IEEE 519 Safe Grid Voltage THD (%)
THD_WARNING_MAX=8.0               # Harmonic Distortion Warning (%)
THD_DANGER_MIN=10.0               # Severe Harmonic Heating & Bearing Fluting Risk (%)

# Grid Frequency (50 Hz Nominal)
FREQ_NORMAL_MIN=49.5              # Minimum Grid Frequency (Hz)
FREQ_NORMAL_MAX=50.5              # Maximum Grid Frequency (Hz)
FREQ_DANGER_UNDER=48.5            # Under-Frequency Grid Instability (Hz)
FREQ_DANGER_OVER=51.5             # Over-Frequency Grid Instability (Hz)

# ------------------------------------------------------------------------------
# 7. Asset Defaults, RUL Forecasting & Maintenance Policy (Agent Delta)
# ------------------------------------------------------------------------------
DEFAULT_RPM=1480.0                # Default Nominal Motor Speed (RPM)
DEFAULT_BEARING_TYPE=SKF-6208     # Default Baseline Bearing
MOTOR_RATED_KW=37.0               # Default Nameplate Motor Rating (kW)
ALPHA_BUFFER_SIZE=30              # Agent Alpha Ring Buffer Window Size
RUL_SKIP_THRESHOLD_DAYS=45.0      # RUL Threshold: Skip PM order if RUL > this and healthy
RUL_MODEL_VERSION=physics_weibull_v1 # Active RUL Modeling Engine Version
TRAINING_DATA_DIR=data/training   # Directory for Training Datasets

# ------------------------------------------------------------------------------
# 8. Raw Waveform Envelope FFT & Demodulation (ISO 13373-2)
# ------------------------------------------------------------------------------
WAVEFORM_SAMPLE_RATE_HZ=25600.0   # Piezoelectric Accelerometer Sampling Rate (Hz)
ENVELOPE_BANDPASS_LOW_HZ=2000.0   # Hilbert Demodulation High-Pass Filter (Hz)
ENVELOPE_BANDPASS_HIGH_HZ=10000.0 # Hilbert Demodulation Low-Pass Filter (Hz)
ENVELOPE_MIN_SAMPLES=4096         # Minimum samples for reliable bearing fault FFT
ENVELOPE_MAX_SAMPLES=131072       # Maximum FFT buffer length
ENVELOPE_MAX_FREQ_HZ=500.0        # Diagnostic Frequency Window for BPFI/BPFO/BSF/FTF (Hz)
ENVELOPE_DECIMATE_HZ=2000.0       # Decimation frequency for envelope demodulation
SPECTROGRAM_MIN_SAMPLES=128       # Minimum samples for STFT analysis
SPECTROGRAM_MAX_FREQ_HZ=60.0      # STFT low-frequency spectrogram window (Hz)
SPECTROGRAM_NPERSEG=4096          # STFT segment window size

